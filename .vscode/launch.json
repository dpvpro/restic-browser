{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Restic-Browser (GO)",
      "type": "go",
      "request": "launch",
      "mode": "exec",
      "preLaunchTask": "build debug",
      "cwd": "${workspaceFolder}",
      "env": {
        "RESTIC_REPOSITORY": "${workspaceFolder}/backend/restic/test-repo",
        "RESTIC_PASSWORD": "test-repo-pass"
      },
      "linux": {
        "program": "${workspaceFolder}/bin/Restic-Browser"
      },
      "osx": {
        "program": "${workspaceFolder}/bin/Restic-Browser.app/Contents/MacOS/Restic-Browser"
      },
      "windows": {
        "program": "${workspaceFolder}/bin/Restic-Browser.exe"
      }
    }
  ]
}
